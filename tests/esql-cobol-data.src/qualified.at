AT_SETUP([qualified host variable])

AT_DATA([prog.cbl], [
       IDENTIFICATION              DIVISION.
      ******************************************************************
       PROGRAM-ID.                 prog.
      ******************************************************************
       DATA                        DIVISION.
      ******************************************************************
       WORKING-STORAGE             SECTION.
      *    Two groups containing identically named VAL to force the
      *    parser to use the GRP qualification for disambiguation.
       01  GRPA.
         03 ROW OCCURS 5.
           05 VAL PIC 9(4).

       01  GRPB.
         03 ROW2 OCCURS 5.
           05 VAL PIC 9(4).

       01  IDX                     PIC  S9(02).

       01  DBNAME                  PIC  X(30) VALUE SPACE.
       01  USERNAME                PIC  X(30) VALUE SPACE.
       01  PASSWD                  PIC  X(10) VALUE SPACE.

      ******************************************************************
       PROCEDURE                   DIVISION.
      ******************************************************************
       MAIN-RTN.

       PERFORM SETUP-DB.

      *    READ ROWS USING QUALIFIED SUBSCRIPTED HOST VARIABLE
           PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 5
               EXEC SQL
                   SELECT FIELD INTO :GRPB.VAL(IDX)
                     FROM TESTTABLE WHERE N = :IDX
               END-EXEC
           END-PERFORM.

           PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 5
               DISPLAY VAL OF ROW2(IDX)
           END-PERFORM.

       PERFORM CLEANUP-DB.

      *    END
           STOP RUN.

      ******************************************************************
       SETUP-DB.
      ******************************************************************

      *    SERVER
           MOVE  "<|DB_NAME|>@<|DB_HOST|>:<|DB_PORT|>"
             TO DBNAME.
           MOVE  "<|DB_USER|>"
             TO USERNAME.
           MOVE  "<|DB_PASSWORD|>"
             TO PASSWD.

           EXEC SQL
               CONNECT :USERNAME IDENTIFIED BY :PASSWD USING :DBNAME
           END-EXEC.

           EXEC SQL
               DROP TABLE IF EXISTS TESTTABLE
           END-EXEC.

           EXEC SQL
                CREATE TABLE TESTTABLE
                (
                    N         NUMERIC(2,0) NOT NULL,
                    FIELD     NUMERIC(4,0) NOT NULL
                )
           END-EXEC.

      *    SEED TEST DATA INTO GRPA (kept untouched so we can verify GRPB
      *    is what actually gets written by the SELECT INTO)
           MOVE 1111 TO VAL OF ROW(1).
           MOVE 1111 TO VAL OF ROW(2).
           MOVE 1111 TO VAL OF ROW(3).
           MOVE 1111 TO VAL OF ROW(4).
           MOVE 1111 TO VAL OF ROW(5).

      *    INSERT ROWS USING QUALIFIED SUBSCRIPTED HOST VARIABLE IN VALUES
           MOVE 1000 TO VAL OF ROW2(1).
           MOVE 2000 TO VAL OF ROW2(2).
           MOVE 3000 TO VAL OF ROW2(3).
           MOVE 4000 TO VAL OF ROW2(4).
           MOVE 5000 TO VAL OF ROW2(5).
           PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 5
              EXEC SQL
                 INSERT INTO TESTTABLE VALUES (:IDX, :GRPB.VAL(IDX))
              END-EXEC
           END-PERFORM.

      *    CLEAR GRPB so we can verify the round trip below
           MOVE ZERO TO VAL OF ROW2(1).
           MOVE ZERO TO VAL OF ROW2(2).
           MOVE ZERO TO VAL OF ROW2(3).
           MOVE ZERO TO VAL OF ROW2(4).
           MOVE ZERO TO VAL OF ROW2(5).

      *    COMMIT
           EXEC SQL
               COMMIT WORK
           END-EXEC.

      ******************************************************************
       CLEANUP-DB.
      ******************************************************************
           EXEC SQL
               DROP TABLE IF EXISTS TESTTABLE
           END-EXEC.

           EXEC SQL
               DISCONNECT ALL
           END-EXEC.

])

AT_CHECK([${EMBED_DB_INFO} prog.cbl])
AT_CHECK([${COMPILE_MODULE} prog.cbl])
AT_CHECK([${RUN_MODULE_LOG} prog], [0],
[1000
2000
3000
4000
5000
], [ignore])

AT_CLEANUP
