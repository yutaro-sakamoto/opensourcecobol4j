AT_SETUP([qualified-name subscript inside host variable])

AT_DATA([prog.cbl], [
       IDENTIFICATION              DIVISION.
      ******************************************************************
       PROGRAM-ID.                 prog.
      ******************************************************************
       DATA                        DIVISION.
      ******************************************************************
       WORKING-STORAGE             SECTION.
       01  GRP.
         03 ROW OCCURS 5.
           05 VAL PIC 9(4).

       01  GRP2.
         03 TMP-IDX PIC S9(02) VALUE 0.

       01  IDX                     PIC  S9(02).

       01  DBNAME                  PIC  X(30) VALUE SPACE.
       01  USERNAME                PIC  X(30) VALUE SPACE.
       01  PASSWD                  PIC  X(10) VALUE SPACE.

      ******************************************************************
       PROCEDURE                   DIVISION.
      ******************************************************************
       MAIN-RTN.

       PERFORM SETUP-DB.

      *    GRP2 経由の修飾名を添字として SELECT INTO に渡す
           PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 5
               MOVE IDX TO TMP-IDX OF GRP2
               EXEC SQL
                   SELECT FIELD INTO :GRP.VAL(GRP2.TMP-IDX)
                     FROM TESTTABLE WHERE N = :IDX
               END-EXEC
           END-PERFORM.

           PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 5
               DISPLAY VAL(IDX)
           END-PERFORM.

       PERFORM CLEANUP-DB.

      *    END
           STOP RUN.

      ******************************************************************
       SETUP-DB.
      ******************************************************************

      *    SERVER
           MOVE  "<|DB_NAME|>@<|DB_HOST|>:<|DB_PORT|>"
             TO DBNAME.
           MOVE  "<|DB_USER|>"
             TO USERNAME.
           MOVE  "<|DB_PASSWORD|>"
             TO PASSWD.

           EXEC SQL
               CONNECT :USERNAME IDENTIFIED BY :PASSWD USING :DBNAME
           END-EXEC.

           EXEC SQL
               DROP TABLE IF EXISTS TESTTABLE
           END-EXEC.

           EXEC SQL
                CREATE TABLE TESTTABLE
                (
                    N         NUMERIC(2,0) NOT NULL,
                    FIELD     NUMERIC(4,0) NOT NULL
                )
           END-EXEC.

      *    SEED VIA QUALIFIED-NAME SUBSCRIPT FOR INSERT VALUES TOO
           MOVE 1000 TO VAL(1).
           MOVE 2000 TO VAL(2).
           MOVE 3000 TO VAL(3).
           MOVE 4000 TO VAL(4).
           MOVE 5000 TO VAL(5).
           PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 5
              MOVE IDX TO TMP-IDX OF GRP2
              EXEC SQL
                 INSERT INTO TESTTABLE VALUES (:IDX, :VAL(GRP2.TMP-IDX))
              END-EXEC
           END-PERFORM.

      *    Clear VAL so the SELECT INTO above is the only thing that
      *    can refill it.
           MOVE ZERO TO VAL(1).
           MOVE ZERO TO VAL(2).
           MOVE ZERO TO VAL(3).
           MOVE ZERO TO VAL(4).
           MOVE ZERO TO VAL(5).

      *    COMMIT
           EXEC SQL
               COMMIT WORK
           END-EXEC.

      ******************************************************************
       CLEANUP-DB.
      ******************************************************************
           EXEC SQL
               DROP TABLE IF EXISTS TESTTABLE
           END-EXEC.

           EXEC SQL
               DISCONNECT ALL
           END-EXEC.

])

AT_CHECK([${EMBED_DB_INFO} prog.cbl])
AT_CHECK([${COMPILE_MODULE} prog.cbl])
AT_CHECK([${RUN_MODULE_LOG} prog], [0],
[1000
2000
3000
4000
5000
], [ignore])

AT_CLEANUP
