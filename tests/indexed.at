# COBOL level tests that read or write INDEXED files.  They are collected
# into a suite of their own because CI has to run them serially: INDEXED
# files are backed by SQLite via sqlite-jdbc, which unpacks its native
# library into a shared temporary directory and prunes stale copies at JVM
# startup.  When several JVMs do that at once the prune fails on Windows,
# because another JVM still holds the library open, and sqlite-jdbc reports
# it on stderr, which fails the test group.
#
# The other INDEXED file tests live in the cobj-idx suite, which covers the
# cobj-idx command itself, and in the file-lock suites, which are serial for
# a different reason: they deliberately contend for locks between concurrent
# processes.
#
# The Nihongo Filename group of i18n_sjis.src, i18n_utf8.src and
# cobol_utf8.src/user-defined-word.at is the exception: it opens an INDEXED
# file but cannot move here, because each of those suites exists in only one
# of the SJIS and UTF-8 builds while this suite is built in both.  It is
# harmless where it is: it is the only group in its suite that loads
# sqlite-jdbc, so there is never a second JVM to race with.

AT_INIT([INDEXED file])

m4_include([index-file-status.at])
m4_include([validate-indexed-file-keys.at])
m4_include([record-key-duplicates-error.at])
m4_include([read_prev_after_start.at])
m4_include([assign_external.at])
m4_include([split-keys.at])
m4_include([file-control-indexed.at])
m4_include([abort-on-file-error.at])
