AT_SETUP([EXEC JAVA basic])

AT_DATA([prog.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WRK-NUM PIC 9(4) VALUE 0.
       PROCEDURE DIVISION.
           MOVE 10 TO WRK-NUM.
           EXEC JAVA
              int n = :WRK-NUM.getInt();
              n = n * 3;
              :WRK-NUM.setInt(n);
              System.out.println("java n=" + n);
           END-EXEC.
           DISPLAY "NUM=" WRK-NUM.
           STOP RUN.
])

AT_CHECK([${COBJ} prog.cbl])
AT_CHECK([java prog], [0],
[java n=30
NUM=0030
])

AT_CLEANUP

AT_SETUP([EXEC JAVA host variable read and write])

AT_DATA([prog.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WRK-STR PIC X(5) VALUE SPACE.
       01 GRP.
          05 WRK-SUB PIC 9(2) VALUE 5.
       PROCEDURE DIVISION.
           EXEC JAVA
              :WRK-STR.moveFrom("abc");
              :WRK-SUB.setInt(:WRK-SUB.getInt() + 1);
           END-EXEC.
           DISPLAY "STR=" WRK-STR "/".
           DISPLAY "SUB=" WRK-SUB.
           STOP RUN.
])

AT_CHECK([${COBJ} prog.cbl])
AT_CHECK([java prog], [0],
[STR=abc  /
SUB=06
])

AT_CLEANUP

AT_SETUP([EXEC JAVA no substitution in literals and comments])

AT_DATA([prog.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WRK-A PIC 9(2) VALUE 1.
       PROCEDURE DIVISION.
           EXEC JAVA
              // line comment: :WRK-A is not replaced here
              /* block comment: :WRK-A END-EXEC
                 is not a terminator inside a comment */
              String s = ":WRK-A stays literal";
              char c = ':';
              System.out.println(s + c);
              :WRK-A.setInt(7);
           END-EXEC.
           DISPLAY "A=" WRK-A.
           STOP RUN.
])

AT_CHECK([${COBJ} prog.cbl])
AT_CHECK([java prog], [0],
[:WRK-A stays literal:
A=07
])

AT_CLEANUP

AT_SETUP([EXEC JAVA block scope])

AT_DATA([prog.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WRK-A PIC 9(2) VALUE 0.
       PROCEDURE DIVISION.
           EXEC JAVA
              int n = 1;
              :WRK-A.setInt(n);
           END-EXEC.
           EXEC JAVA
              int n = 2;
              :WRK-A.setInt(:WRK-A.getInt() + n);
           END-EXEC.
           DISPLAY "A=" WRK-A.
           STOP RUN.
])

AT_CHECK([${COBJ} prog.cbl])
AT_CHECK([java prog], [0],
[A=03
])

AT_CLEANUP

AT_SETUP([EXEC JAVA percent and END-EXEC in string literal])

AT_DATA([prog.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WRK-A PIC 9(2) VALUE 0.
       PROCEDURE DIVISION.
           EXEC JAVA
              String t = "END-EXEC";
              System.out.println("100% " + t);
              :WRK-A.setInt(8);
           END-EXEC.
           DISPLAY "A=" WRK-A.
           STOP RUN.
])

AT_CHECK([${COBJ} prog.cbl])
AT_CHECK([java prog], [0],
[100% END-EXEC
A=08
])

AT_CLEANUP

AT_SETUP([EXEC JAVA method reference and ternary operator])

AT_DATA([prog.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WRK-NUM PIC 9(2) VALUE 9.
       01 WRK-STR PIC X(3) VALUE "abc".
       PROCEDURE DIVISION.
           EXEC JAVA
              java.util.function.Supplier<String> sup =
                 :WRK-STR::toString;
              int r = :WRK-NUM.getInt() > 5 ? 1 : 0;
              :WRK-NUM.setInt(sup.get() != null ? r + 1 : 99);
           END-EXEC.
           DISPLAY "NUM=" WRK-NUM.
           STOP RUN.
])

AT_CHECK([${COBJ} prog.cbl])
AT_CHECK([java prog], [0],
[NUM=02
])

AT_CLEANUP

AT_SETUP([EXEC JAVA free source format])

AT_DATA([prog.cbl], [IDENTIFICATION DIVISION.
PROGRAM-ID. prog.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 WRK-A PIC 9(2) VALUE 0.
PROCEDURE DIVISION.
    EXEC JAVA
       int veryLongJavaLocalVariableNameThatWouldNotFitInFixedFormatColumns = 40;
       :WRK-A.setInt(veryLongJavaLocalVariableNameThatWouldNotFitInFixedFormatColumns + 2);
    END-EXEC.
    DISPLAY "A=" WRK-A.
    STOP RUN.
])

AT_CHECK([${COBJ} -free prog.cbl])
AT_CHECK([java prog], [0],
[A=42
])

AT_CLEANUP

AT_SETUP([EXEC JAVA IMPORT])

AT_DATA([prog.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       EXEC JAVA IMPORT
          import java.util.ArrayList;
          import java.util.List;
          import static java.lang.Math.max;
          // duplicates are folded into one, stray ';' is skipped
          import java.util.List;;
       END-EXEC.
       01 WRK-N PIC 9(2) VALUE 0.
       PROCEDURE DIVISION.
           EXEC JAVA IMPORT
              import java.util.function.*;
           END-EXEC.
           EXEC JAVA
              List<Integer> xs = new ArrayList<Integer>();
              xs.add(3);
              xs.add(7);
              Supplier<Integer> s = () -> max(xs.get(0), xs.get(1));
              :WRK-N.setInt(s.get());
           END-EXEC.
           DISPLAY "N=" WRK-N.
           STOP RUN.
])

AT_CHECK([${COBJ} prog.cbl])
AT_CHECK([grep -c "^import java.util.List;" prog.java], [0], [1
])
AT_CHECK([java prog], [0],
[N=07
])

AT_CLEANUP

AT_SETUP([EXEC JAVA IMPORT invalid declaration])

AT_DATA([prog.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       EXEC JAVA IMPORT
          int x = 1;
       END-EXEC.
       01 WRK-N PIC 9(2) VALUE 0.
       PROCEDURE DIVISION.
           STOP RUN.
])

AT_CHECK([${COBJ} prog.cbl], [1], [ignore], [ignore])

AT_DATA([prog2.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog2.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       EXEC JAVA IMPORT
          import int.foo;
       END-EXEC.
       01 WRK-N PIC 9(2) VALUE 0.
       PROCEDURE DIVISION.
           STOP RUN.
])

AT_CHECK([${COBJ} prog2.cbl], [1], [ignore], [ignore])

AT_DATA([prog3.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog3.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       EXEC JAVA IMPORT
          import *;
       END-EXEC.
       01 WRK-N PIC 9(2) VALUE 0.
       PROCEDURE DIVISION.
           STOP RUN.
])

AT_CHECK([${COBJ} prog3.cbl], [1], [ignore], [ignore])

AT_CLEANUP

AT_SETUP([EXEC JAVA IMPORT reports every declaration with its line])

AT_DATA([prog.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       EXEC JAVA IMPORT
          import static;
          import int.foo;
          int x = 1;
       END-EXEC.
       01 WRK-N PIC 9(2) VALUE 0.
       PROCEDURE DIVISION.
           STOP RUN.
])

AT_CHECK([${COBJ} prog.cbl 2>&1 | grep -c "^prog.cbl:@<:@0-9@:>@*: Error: EXEC JAVA IMPORT"], [0], [3
])
AT_CHECK([${COBJ} prog.cbl 2>&1 | grep -c "^prog.cbl:7: Error: EXEC JAVA IMPORT: invalid import declaration"], [0], [1
])
AT_CHECK([${COBJ} prog.cbl 2>&1 | grep -c "^prog.cbl:9: Error: EXEC JAVA IMPORT: not an import declaration"], [0], [1
])

AT_CLEANUP

AT_SETUP([EXEC JAVA missing END-EXEC])

AT_DATA([prog.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WRK-N PIC 9(2) VALUE 0.
       PROCEDURE DIVISION.
           EXEC JAVA
              int n = 1;
           STOP RUN.
])

AT_CHECK([${COBJ} prog.cbl 2>&1 | grep -c "EXEC JAVA statement is not terminated by END-EXEC"], [0], [1
])

AT_DATA([prog2.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog2.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       EXEC JAVA CLASS-MEMBER
          private int x = 1;
])

AT_CHECK([${COBJ} prog2.cbl 2>&1 | grep -c "EXEC JAVA CLASS-MEMBER statement is not terminated by END-EXEC"], [0], [1
])

AT_CLEANUP

AT_SETUP([EXEC JAVA consecutive semicolons])

AT_DATA([prog.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WRK-A PIC 9(2) VALUE 0.
       PROCEDURE DIVISION.
           EXEC JAVA
              int i = 0;
              for (;;) { i++; if (i > 2) break; }
              String t = "a;;b";;
              System.out.println(t + i);
              :WRK-A.setInt(i);
           END-EXEC.
           DISPLAY "A=" WRK-A.
           STOP RUN.
])

AT_CHECK([${COBJ} prog.cbl])
AT_CHECK([java prog], [0],
[a;;b3
A=03
])

AT_CLEANUP

AT_SETUP([EXEC JAVA CLASS-MEMBER])

AT_DATA([prog.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       EXEC JAVA CLASS-MEMBER
          private int counter = 0;
          private int nextCounter() {
             return ++counter;
          }
          private String greet(String name) {
             return "hello, " + name + " #" + :WRK-N.getInt();
          }
       END-EXEC.
       01 WRK-N PIC 9(2) VALUE 0.
       01 WRK-S PIC X(16) VALUE SPACE.
       PROCEDURE DIVISION.
           EXEC JAVA
              :WRK-N.setInt(nextCounter());
              :WRK-N.setInt(nextCounter());
              :WRK-S.moveFrom(greet("cobol"));
           END-EXEC.
           DISPLAY "N=" WRK-N.
           DISPLAY "S=" WRK-S "/".
           STOP RUN.
])

AT_CHECK([${COBJ} prog.cbl])
AT_CHECK([java prog], [0],
[N=02
S=hello, cobol #2 /
])

AT_DATA([prog2.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog2.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WRK-S PIC X(8) VALUE SPACE.
       PROCEDURE DIVISION.
      * CLASS-MEMBER at a statement position; ';;' kept in the string
           EXEC JAVA CLASS-MEMBER
              private String tag() {
                 return "a;;b";
              }
           END-EXEC.
           EXEC JAVA
              :WRK-S.moveFrom(tag());
           END-EXEC.
           DISPLAY "S=" WRK-S "/".
           STOP RUN.
])

AT_CHECK([${COBJ} prog2.cbl])
AT_CHECK([java prog2], [0],
[S=a;;b    /
])

AT_CLEANUP

AT_SETUP([EXEC JAVA CLASS-MEMBER undefined host variable])

AT_DATA([prog.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       EXEC JAVA CLASS-MEMBER
          private int bad() { return :NO-SUCH.getInt(); }
       END-EXEC.
       01 WRK-N PIC 9(2) VALUE 0.
       PROCEDURE DIVISION.
           STOP RUN.
])

AT_CHECK([${COBJ} prog.cbl], [1], [ignore], [ignore])

AT_CLEANUP

AT_SETUP([EXEC JAVA undefined host variable])

AT_DATA([prog.cbl], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WRK-A PIC 9(2) VALUE 0.
       PROCEDURE DIVISION.
           EXEC JAVA
              :NO-SUCH-VAR.setInt(1);
           END-EXEC.
           STOP RUN.
])

AT_CHECK([${COBJ} prog.cbl], [1], [ignore], [ignore])

AT_CLEANUP
