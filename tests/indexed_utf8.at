# The INDEXED file tests that only make sense in the --enable-utf8 build.
# They are kept apart from the other UTF-8 tests for the same reason as the
# indexed suite: CI has to run them serially, because INDEXED files are
# backed by SQLite via sqlite-jdbc, which unpacks its native library into a
# shared temporary directory and prunes stale copies at JVM startup.  When
# several JVMs do that at once the prune fails on Windows, because another
# JVM still holds the library open, and sqlite-jdbc reports it on stderr,
# which fails the test group.
#
# The build independent INDEXED file tests live in the indexed suite.

AT_INIT([INDEXED file (UTF-8)])

m4_include([nihongo-filename.at])
