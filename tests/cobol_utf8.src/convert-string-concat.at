AT_SETUP([convert '&' concatenated strings to Java])
export LC_ALL=''

AT_DATA([prog.cbl], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA DIVISION.
       WORKING-STORAGE  SECTION.
       01  X-CONCAT     PIC X(25) VALUE "abcde"
        &  "fghij"
        &  "klmno"
        &  "pqrst"
        &  "uvwxy".
       01  N-CONCAT     PIC N(25) VALUE "あいうえお"
        &  "かきくけこ"
        &  "さしすせそ"
        &  "たちつてと"
        &  "なにぬねの".
       PROCEDURE        DIVISION.
       MAIN-RTN.
           DISPLAY X-CONCAT.
           DISPLAY N-CONCAT.
           STOP RUN.
])

AT_CHECK([${COMPILE} prog.cbl])
AT_CHECK([java prog > out1.txt])
AT_CHECK([echo 'abcdefghijklmnopqrstuvwxy
あいうえおかきくけこさしすせそたちつてとなにぬねの'| nkf -x --ic=UTF-8 --oc=Shift_JIS > out2.txt])
AT_CHECK([diff out1.txt out2.txt])
dnl The Shift_JIS build also writes one Java string per '&' segment, which the
dnl misc counterpart of this group checks.  joutput_string_write emits the
dnl whole literal as a single string on a UTF-8 build, so only the value is
dnl checked here.
AT_CHECK([grep -q 'abcdefghijklmnopqrstuvwxy' prog.java])
AT_CHECK([grep -q 'あいうえおかきくけこさしすせそたちつてとなにぬねの' prog.java])
AT_CLEANUP
