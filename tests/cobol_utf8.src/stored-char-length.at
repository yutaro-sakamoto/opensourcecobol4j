# FUNCTION STORED-CHAR-LENGTH currently returns the number of *bytes* up to the
# last non-space character, not the number of characters (see the ASCII cases in
# run.src/functions.at).  The tests below describe the character-counting
# behaviour these cases are meant to have and are skipped until it is
# implemented; only the cases that agree with today's byte-oriented result run.

AT_SETUP([FUNCTION STORED-CHAR-LENGTH(PIC X)])
export LC_ALL=''
AT_CHECK([${SKIP_TEST}])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       77 NSTR         PIC X(30) USAGE DISPLAY.
       77 NLEN         PIC 9(2)  USAGE DISPLAY.
       PROCEDURE        DIVISION.
           MOVE ".プリウスα" TO NSTR.
           MOVE FUNCTION STORED-CHAR-LENGTH(NSTR) TO NLEN.
           DISPLAY NLEN WITH NO ADVANCING.
           STOP RUN.
])

AT_CHECK([${COMPILE} prog.cob])
AT_CHECK([java prog], [0], [06])

AT_CLEANUP

AT_SETUP([FUNCTION STORED-CHAR-LENGTH(PIC X) /w SPC])
