AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       77 NSTR         PIC N(10) USAGE DISPLAY.
       77 NLEN         PIC 9(2)  USAGE DISPLAY.
       PROCEDURE        DIVISION.
