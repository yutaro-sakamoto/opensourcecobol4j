AT_SETUP([STRING Alphanumeric to National])
export LC_ALL=''

AT_DATA([prog.cob], [
       IDENTIFICATION  DIVISION.
       PROGRAM-ID.     prog.
       DATA            DIVISION.
       WORKING-STORAGE SECTION.
       01 X       PIC X(6) value "procob".
       01 Y       PIC N(6).
       PROCEDURE       DIVISION.
           STRING X DELIMITED BY SIZE INTO Y.
           DISPLAY Y NO ADVANCING.
           STOP RUN.
])

AT_CHECK([${COMPILE} prog.cob])
AT_CHECK([java prog > out1.txt])
AT_CHECK([echo -n "procob　　　" | nkf --ic=UTF-8 --oc=Shift_JIS > out2.txt])
AT_CHECK([diff out1.txt out2.txt])

AT_CLEANUP

AT_SETUP([STRING National to Alphanumeric])
export LC_ALL=''

AT_DATA([prog.cob], [
       IDENTIFICATION  DIVISION.
       PROGRAM-ID.     prog.
       DATA            DIVISION.
       WORKING-STORAGE SECTION.
       01 X       PIC N(6) VALUE "ｐｒｏｃｏｂ".
       01 Y       PIC X(18).
       PROCEDURE DIVISION.
           STRING X DELIMITED BY SIZE INTO Y.
           DISPLAY Y NO ADVANCING.
           STOP RUN.
])

AT_CHECK([${COMPILE} prog.cob])
AT_CHECK([java prog > out1.txt])
AT_CHECK([echo -n "ｐｒｏｃｏｂ      " | nkf --ic=UTF-8 --oc=Shift_JIS > out2.txt])
AT_CHECK([diff out1.txt out2.txt])

AT_CLEANUP
