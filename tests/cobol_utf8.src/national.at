AT_SETUP([N Literal (NO zenakaku conversion)])
export LC_ALL=''

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       PROCEDURE        DIVISION.
           DISPLAY N"いろは".
           DISPLAY N"ｲﾛﾊ".
           DISPLAY N"ﾎﾟﾋﾟﾝ".
           DISPLAY N"ABC".
           DISPLAY N"#$%".
           STOP RUN.
])

AT_CHECK([cobj prog.cob])
AT_CHECK([java prog], [0],
[いろは
ｲﾛﾊ
ﾎﾟﾋﾟﾝ
ABC
#$%
])

AT_CLEANUP

