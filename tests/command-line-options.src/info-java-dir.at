AT_SETUP([-info-java-dir])

AT_CHECK([${COBJ} --help | grep info-json-dir > /dev/null], [0])

AT_DATA([callee.cbl], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      callee.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       LINKAGE          SECTION.
       01 P1            PIC X ANY LENGTH.
       01 P2            PIC 99.
       01 P3            PIC 9V9.
       PROCEDURE        DIVISION USING P1 P2 P3.
           GOBACK.
])

AT_DATA([prog.cbl], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       LINKAGE          SECTION.
       PROCEDURE        DIVISION.
           STOP RUN.
])

# The version embedded in the JSON must match the version of the cobj
# binary, so derive it from `cobj --version` instead of hardcoding a
# release number that breaks on every version bump. The sed commands
# below replace the version with a placeholder only when it matches the
# binary's version, so a mismatch still fails the comparison.
COBJ_VERSION=$(${COBJ} --version | sed -n '1s/.* //p')

# a basic usecase
AT_CHECK([${COBJ} -info-json-dir=./ callee.cbl prog.cbl])
AT_CHECK([sed "s/\"opensourcecobol4j_version\": \"$COBJ_VERSION\"/\"opensourcecobol4j_version\": \"COBJ_VERSION\"/" info_callee.json], [0],
[{
  "opensourcecobol4j_version": "COBJ_VERSION",
  "program_id": "callee",
  "procedure_division_using_parameters": @<:@
    {
      "variable_name": "P1",
      "java_type": "String"
    },
    {
      "variable_name": "P2",
      "java_type": "int"
    },
    {
      "variable_name": "P3",
      "java_type": "double"
    }
  @:>@
}
])

AT_CHECK([sed "s/\"opensourcecobol4j_version\": \"$COBJ_VERSION\"/\"opensourcecobol4j_version\": \"COBJ_VERSION\"/" info_prog.json], [0],
[{
  "opensourcecobol4j_version": "COBJ_VERSION",
  "program_id": "prog",
  "procedure_division_using_parameters": @<:@
  @:>@
}
])

# specify an invalid directory
AT_CHECK([${COBJ} -info-json-dir=aaa callee.cbl prog.cbl], [0], [],
[Warning: failed to open a json file aaa/info_callee.json
Warning: failed to open a json file aaa/info_prog.json
])

# specify an existing directory
AT_CHECK([mkdir bbb])
AT_CHECK([${COBJ} -info-json-dir=bbb callee.cbl prog.cbl])

AT_CHECK([sed "s/\"opensourcecobol4j_version\": \"$COBJ_VERSION\"/\"opensourcecobol4j_version\": \"COBJ_VERSION\"/" bbb/info_callee.json], [0],
[{
  "opensourcecobol4j_version": "COBJ_VERSION",
  "program_id": "callee",
  "procedure_division_using_parameters": @<:@
    {
      "variable_name": "P1",
      "java_type": "String"
    },
    {
      "variable_name": "P2",
      "java_type": "int"
    },
    {
      "variable_name": "P3",
      "java_type": "double"
    }
  @:>@
}
])

AT_CHECK([sed "s/\"opensourcecobol4j_version\": \"$COBJ_VERSION\"/\"opensourcecobol4j_version\": \"COBJ_VERSION\"/" bbb/info_prog.json], [0],
[{
  "opensourcecobol4j_version": "COBJ_VERSION",
  "program_id": "prog",
  "procedure_division_using_parameters": @<:@
  @:>@
}
])

AT_CLEANUP