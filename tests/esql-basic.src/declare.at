AT_SETUP([declare statement test])

AT_DATA([prog.cbl], [
       IDENTIFICATION              DIVISION.
      ******************************************************************
       PROGRAM-ID.                 prog.
      ******************************************************************
       DATA                        DIVISION.
      ******************************************************************
       WORKING-STORAGE             SECTION.
           EXEC SQL INCLUDE SQLCA END-EXEC.
       01 TEST-CASE-COUNT PIC 9999 VALUE 1.

       01  DBNAME                  PIC  X(30) VALUE SPACE.
       01  USERNAME                PIC  X(30) VALUE SPACE.
       01  PASSWD                  PIC  X(10) VALUE SPACE.

       01  EMP-REC-VARS.
         03  EMP-NO                PIC S9(04) VALUE ZERO.
         03  EMP-NAME              PIC  X(20) .
         03  EMP-SALARY            PIC S9(04) VALUE ZERO.

      ******************************************************************
       PROCEDURE                   DIVISION.
      ******************************************************************
       MAIN-RTN.
           
       PERFORM SETUP-DB.

      * Test case 0001 *************************************************
       EXEC SQL
           DECLARE CURSOR1 CURSOR FOR SELECT * FROM EMP
       END-EXEC.
       PERFORM DISPLAY-TEST-RESULT.
      ******************************************************************

      * Test case 0002 *************************************************
       EXEC SQL
           DECLARE CURSOR2 CURSOR FOR SELECT EMP-NO FROM EMP
       END-EXEC.
       PERFORM DISPLAY-TEST-RESULT.
      ******************************************************************

      * Test case 0003 *************************************************
       EXEC SQL
           DECLARE CURSOR3 CURSOR FOR SELECT EMP-NO, EMP-SALARY FROM EMP
       END-EXEC.
       PERFORM DISPLAY-TEST-RESULT.
      ******************************************************************

       PERFORM CLEANUP-DB.

      *    END
           STOP RUN.

      ******************************************************************
       SETUP-DB.
      ******************************************************************

      *    SERVER
           MOVE  "<|DB_NAME|>@<|DB_HOST|>:<|DB_PORT|>"
             TO DBNAME.
           MOVE  "<|DB_USER|>"
             TO USERNAME.
           MOVE  "<|DB_PASSWORD|>"
             TO PASSWD.

           EXEC SQL
               CONNECT :USERNAME IDENTIFIED BY :PASSWD USING :DBNAME 
           END-EXEC.

           EXEC SQL
               DROP TABLE IF EXISTS EMP
           END-EXEC.

           EXEC SQL
                CREATE TABLE EMP
                (
                    EMP_NO     NUMERIC(4,0) NOT NULL,
                    EMP_NAME   CHAR(20),
                    EMP_SALARY NUMERIC(4,0),
                    CONSTRAINT IEMP_0 PRIMARY KEY (EMP_NO)
                )
           END-EXEC.

      ******************************************************************
       CLEANUP-DB.
      ******************************************************************
           EXEC SQL
               DROP TABLE IF EXISTS EMP
           END-EXEC.

           EXEC SQL
               DISCONNECT ALL
           END-EXEC.

      ******************************************************************
       DISPLAY-TEST-RESULT.
      ******************************************************************
           IF  SQLCODE = ZERO
             THEN

               DISPLAY "<log> test case " TEST-CASE-COUNT ": success"
               ADD 1 TO TEST-CASE-COUNT

             ELSE
               DISPLAY "*** SQL ERROR ***"
               DISPLAY "SQLCODE: " SQLCODE " " NO ADVANCING
               EVALUATE SQLCODE
                  WHEN  +10
                     DISPLAY "Record not found"
                  WHEN  -01
                     DISPLAY "Connection falied"
                  WHEN  -20
                     DISPLAY "Internal error"
                  WHEN  -30
                     DISPLAY "PostgreSQL error"
                     DISPLAY "ERRCODE: "  SQLSTATE
                     DISPLAY SQLERRMC
                  *> TO RESTART TRANSACTION, DO ROLLBACK.
                     EXEC SQL
                         ROLLBACK
                     END-EXEC
                  WHEN  OTHER
                     DISPLAY "Undefined error"
                     DISPLAY "ERRCODE: "  SQLSTATE
                     DISPLAY SQLERRMC
               END-EVALUATE
               STOP RUN.
      ******************************************************************  

])
AT_CHECK([${EMBED_DB_INFO} prog.cbl])
AT_CHECK([${COMPILE_MODULE} prog.cbl])
AT_CHECK([${RUN_MODULE_LOG} prog], [0],
[<log> test case 0001: success
<log> test case 0002: success
<log> test case 0003: success
],
[DEBUG CONNECT successful (id=OCDB_DEFAULT_DBNAME)
DEBUG EXEC SQL: DROP TABLE IF EXISTS EMP
DEBUG EXEC SQL: CREATE TABLE EMP ( EMP_NO NUMERIC(4,0) NOT NULL, EMP_NAME CHAR(20), EMP_SALARY NUMERIC(4,0), CONSTRAINT IEMP_0 PRIMARY KEY (EMP_NO) )
DEBUG DECLARE CURSOR prog_CURSOR1 FOR: SELECT * FROM EMP
DEBUG DECLARE CURSOR prog_CURSOR2 FOR: SELECT EMP-NO FROM EMP
DEBUG DECLARE CURSOR prog_CURSOR3 FOR: SELECT EMP-NO, EMP-SALARY FROM EMP
DEBUG EXEC SQL: DROP TABLE IF EXISTS EMP
DEBUG DISCONNECT (id=OCDB_DEFAULT_DBNAME)
])
AT_CLEANUP