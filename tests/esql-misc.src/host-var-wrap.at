AT_SETUP([sql format - wrap host variable list every 5 items])

dnl ホスト変数が多数並ぶ生成コードで、5 個ごとに改行して折り返されることを確認する。
dnl 対象は 2 系統:
dnl   - execWithParams 等のホスト変数列 (joutput_sql_host_list_newline)
dnl   - selectInto の AbstractCobolField[] 配列 (joutput_sql_field_array)

AT_DATA([prog.cbl], [
       IDENTIFICATION              DIVISION.
      ******************************************************************
       PROGRAM-ID.                 prog.
      ******************************************************************
       DATA                        DIVISION.
      ******************************************************************
       WORKING-STORAGE             SECTION.
           EXEC SQL INCLUDE SQLCA END-EXEC.

       01  V1                      PIC S9(04) VALUE ZERO.
       01  V2                      PIC S9(04) VALUE ZERO.
       01  V3                      PIC S9(04) VALUE ZERO.
       01  V4                      PIC S9(04) VALUE ZERO.
       01  V5                      PIC S9(04) VALUE ZERO.
       01  V6                      PIC S9(04) VALUE ZERO.
       01  V7                      PIC S9(04) VALUE ZERO.

       01  R1                      PIC S9(04) VALUE ZERO.
       01  R2                      PIC S9(04) VALUE ZERO.
       01  R3                      PIC S9(04) VALUE ZERO.
       01  R4                      PIC S9(04) VALUE ZERO.
       01  R5                      PIC S9(04) VALUE ZERO.
       01  R6                      PIC S9(04) VALUE ZERO.

       PROCEDURE                   DIVISION.
       MAIN-RTN.
      *    7 host variables -> wrapped 5 + 2.
           EXEC SQL
               INSERT INTO T VALUES
               (:V1, :V2, :V3, :V4, :V5, :V6, :V7)
           END-EXEC.

      *    6 result host variables in the INTO array -> wrapped 5 + 1.
           EXEC SQL
               SELECT C1, C2, C3, C4, C5, C6 INTO
               :R1, :R2, :R3, :R4, :R5, :R6 FROM T
           END-EXEC.

      *    Exactly 5 host variables (= SQL_HOST_VAR_WRAP) -> NOT wrapped.
           EXEC SQL
               INSERT INTO T5 VALUES
               (:V1, :V2, :V3, :V4, :V5)
           END-EXEC.

           STOP RUN.
])

# Generate Java only (no class file).
AT_CHECK([${COBJ} -C prog.cbl])

# --- execWithParams host variable list -------------------------------
# The first five host variables stay on one line ...
AT_CHECK([grep -F "f_V1, f_V2, f_V3, f_V4, f_V5," prog.java], [0], [ignore])
# ... the sixth begins a new line together with the seventh.
AT_CHECK([grep -F "f_V6, f_V7);" prog.java], [0], [ignore])
# Negative check: the fifth and sixth must NOT share a line (= wrapped).
AT_CHECK([grep -F "f_V5, f_V6" prog.java], [1], [ignore])

# --- selectInto AbstractCobolField[] array ---------------------------
# The first five result variables stay on one line ...
AT_CHECK([grep -F "f_R1, f_R2, f_R3, f_R4, f_R5," prog.java], [0], [ignore])
# ... the sixth is wrapped onto the next line and closes the array.
AT_CHECK([grep -F "f_R6}" prog.java], [0], [ignore])
# Negative check: the fifth and sixth must NOT share a line (= wrapped).
AT_CHECK([grep -F "f_R5, f_R6" prog.java], [1], [ignore])

# --- exactly SQL_HOST_VAR_WRAP (5) items: no wrapping --------------
# All five must remain on a single line, closed by ");".
AT_CHECK([grep -F "f_V1, f_V2, f_V3, f_V4, f_V5);" prog.java], [0], [ignore])

AT_CLEANUP
