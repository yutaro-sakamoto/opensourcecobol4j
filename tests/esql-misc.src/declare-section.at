AT_SETUP([explicit declare section])

AT_DATA([prog.cbl], [
       IDENTIFICATION              DIVISION.
       PROGRAM-ID.                 prog.
       DATA                        DIVISION.
       WORKING-STORAGE             SECTION.
       EXEC SQL BEGIN DECLARE SECTION END-EXEC.
       01  DBNAME                  PIC  X(30) VALUE SPACE.
       01  USERNAME                PIC  X(30) VALUE SPACE.
       01  PASSWD                  PIC  X(10) VALUE SPACE.
       EXEC SQL END DECLARE SECTION END-EXEC.

       PROCEDURE                   DIVISION.
       MAIN-RTN.
           MOVE  "<|DB_NAME|>@<|DB_HOST|>:<|DB_PORT|>"
             TO DBNAME.
           MOVE  "<|DB_USER|>"
             TO USERNAME.
           MOVE  "<|DB_PASSWORD|>"
             TO PASSWD.

           EXEC SQL
               CONNECT :USERNAME IDENTIFIED BY :PASSWD USING :DBNAME
           END-EXEC.

           EXEC SQL
               DISCONNECT ALL
           END-EXEC.
])

AT_CHECK([${EMBED_DB_INFO} prog.cbl])
AT_CHECK([${COMPILE_MODULE} prog.cbl])
AT_CHECK([${RUN_MODULE_LOG} prog], [0], [],
[DEBUG CONNECT successful (id=OCDB_DEFAULT_DBNAME)
DEBUG DISCONNECT (id=OCDB_DEFAULT_DBNAME)
])

AT_CLEANUP
